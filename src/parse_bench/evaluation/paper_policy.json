{
  "format": "parsebench-metric-policy",
  "version": 1,
  "weights": {
    "critical": 0.1,
    "major": 0.05,
    "minor": 0.01
  },
  "dimension_weights": {
    "text": 1,
    "fmt": 1,
    "tables": 1,
    "charts": 1,
    "layout": 1,
    "forms": 1
  },
  "scaling": {
    "minorCap": 0.15,
    "orderCap": 0.3,
    "textL0": 400,
    "atomsK": 10,
    "tableK": 80,
    "chartK": 10
  },
  "error_classes": {
    "text": {
      "all major errors": "major",
      "moved block (reading order)": "major",
      "cut sentence (reading order)": "major",
      "all critical errors": "critical",
      "all minor errors": "minor"
    },
    "fmt": {
      "all major errors": "major",
      "all minor errors": "minor",
      "all critical errors": "critical"
    },
    "tables": {
      "extra column": "major",
      "systematic column error: wrong text or units (3+ in one column)": "major",
      "systematic column error: small differences (3+ in one column)": "minor",
      "title missing": "major",
      "header rows differ": "major",
      "label reworded (close wording)": "minor",
      "small text difference": "minor",
      "spanned cell not repeated": "major",
      "unpaired output table ignored": "ignore",
      "row out of order": "major",
      "wrong or misplaced number in a row": "critical",
      "empty rows or columns added": "minor",
      "systematic column error: wrong numbers (3+ in one column)": "critical",
      "repeated row": "major",
      "label reworded (repeat, not charged)": "ignore",
      "cell filled where reference is empty": "minor",
      "wrong text, lost unit or partly different value in a row": "major",
      "label reworded (different wording)": "major",
      "row missing": "critical",
      "row-label header differs (mild)": "minor",
      "column headers differ": "minor",
      "table split": "major",
      "tables merged": "major",
      "header rows missing": "critical",
      "row-label header differs": "major",
      "tables stitched": "ignore",
      "tables split at header bands": "ignore",
      "duplicated table": "minor",
      "invented row": "critical",
      "table transposed, structure lost": "critical",
      "table missing (all rows of one table; its rows are charged)": "ignore",
      "label split across rows": "minor",
      "number format changed": "minor",
      "column out of order": "major",
      "values under another label": "critical",
      "letter case changed": "minor",
      "sub-rows merged": "ignore",
      "wrong row span": "major",
      "table transposed": "major",
      "label columns merged": "major",
      "label number changed": "critical",
      "label case changed": "minor",
      "table missing": "critical",
      "column groups wrapped": "major",
      "side-by-side tables merged": "major",
      "label typo": "minor",
      "dash cells read as blank": "ignore",
      "contradicting copy of a table: number": "critical",
      "header rows joined": "major",
      "locale format": "minor",
      "contradicting copy of a table: text": "major"
    },
    "charts": {
      "chart missing": "critical",
      "invented series or category": "major",
      "wrong value": "critical",
      "series missing": "critical",
      "value off": "major",
      "series renamed": "major",
      "title missing": "major",
      "point missing": "major",
      "category missing": "major",
      "wrong title": "major",
      "series name reworded": "minor",
      "derived total": "major",
      "category axis mislabeled": "minor",
      "colour groups merged": "minor",
      "range instead of value": "minor",
      "category label reworded": "major",
      "legend lost (several series)": "critical",
      "label typo": "minor",
      "repeated point": "major",
      "legend lost (one series)": "major",
      "category label truncated": "major"
    },
    "forms": {
      "caption garbled": "minor",
      "empty field omitted": "minor",
      "unchecked option omitted": "minor",
      "unchecked state lost": "minor",
      "invented value": "critical",
      "printed text in a blank field": "minor",
      "form fields missing (under half found; coverage cap applies)": "ignore",
      "value lost": "major",
      "contradicting copy of a field": "critical",
      "signature invented": "critical",
      "value typo": "minor",
      "box state flipped": "critical",
      "checked state lost": "major",
      "field missing": "major",
      "value without its caption": "major",
      "wrong value": "critical",
      "signature lost": "major",
      "extra text in value": "minor",
      "checked option missing": "major",
      "value of another field": "critical",
      "signature field missing": "major",
      "value truncated": "major",
      "amount rounded": "major",
      "extra field": "minor",
      "printed id dropped": "minor",
      "printed id wrong": "minor",
      "form table not kept as a grid": "minor",
      "selected option changed": "critical"
    }
  }
}
